# Copy to .env and fill in. Read by `serve --env-file`, VS Code debug (F5)
# and docker-compose.yml. Auth flags fall back to these variables, so
# `mcp-diary serve --auth-enabled` only needs this file plus the missing flags.

# Google OAuth "Web application" client. The redirect URI must be
# <MCP_PUBLIC_URL>/oauth/callback. The secret stays on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Externally reachable base URL of this server, e.g. https://mcp.example.com.
# It is the OAuth issuer and must match how clients reach the server.
MCP_PUBLIC_URL=

# Optional: 32-byte key (base64 or hex) encrypting OAuth state at rest.
# Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=

# Host port to expose.
MCP_PORT=8080
