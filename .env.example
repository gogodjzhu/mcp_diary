# Copy to .env and fill in. Used by docker-compose.yml.

# Google OAuth client id created in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Externally reachable base URL of this MCP server, e.g. https://mcp.example.com.
# Leave empty only when the server is directly reachable by clients.
MCP_PUBLIC_URL=

# Authorization server issuer (Google).
AUTH_ISSUER=https://accounts.google.com

# Scopes the client must request and tokens must contain.
AUTH_SCOPES=openid,email,profile

# Host port to expose.
MCP_PORT=8080
