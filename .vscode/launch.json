{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve (Web + MCP)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/mcp-diary",
      "args": [
        "serve",
        "--root", "${workspaceFolder}",
        "--addr=:8080",
        "--auth-enabled",
        "--web-enabled",
        "--env-file=${workspaceFolder}/.env"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Serve (stdio)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/mcp-diary",
      "args": ["serve", "--transport", "stdio", "--root", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "List tools",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/mcp-diary",
      "args": ["tools", "--root", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
